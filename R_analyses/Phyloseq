#### Diversity ####
#
#
# Calculate Shannon and Simpson indices
richness_data <- estimate_richness(ps, measures = c("Shannon", "Simpson"))

# Extract metadata from Phyloseq
metadata_df <- as.data.frame(sample_data(ps))

# Combine Shannon and Simpson with metadata
richness_data <- cbind(metadata_df, richness_data)

# Perform Kruskal-Wallis test for Shannon and Simpson indices
kruskal_shannon <- kruskal.test(Shannon ~ Treatment, data = richness_data)
kruskal_simpson <- kruskal.test(Simpson ~ Treatment, data = richness_data)

# Perform pairwise Wilcoxon tests (Kruskal-Wallis' post-hoc)
pairwise_shannon <- pairwise.wilcox.test(richness_data$Shannon, richness_data$Treatment, p.adjust.method = "BH")
pairwise_simpson <- pairwise.wilcox.test(richness_data$Simpson, richness_data$Treatment, p.adjust.method = "BH")

# Print Kruskal-Wallis results
cat("Kruskal-Wallis test for Shannon:", kruskal_shannon$p.value, "\n")
cat("Kruskal-Wallis test for Simpson:", kruskal_simpson$p.value, "\n")

# Create the plot with Kruskal-Wallis and pairwise Wilcoxon annotations
p <- plot_richness(ps, x = "Treatment", shape = "Treatment", color = "Treatment", 
                   measures = c("Shannon", "Simpson"))

# Add boxplot, points, and comparisons with stat_compare_means (using Kruskal-Wallis)
p + 
  geom_point(size = 3) + 
  geom_boxplot(alpha = 0.6) +
  theme(legend.position = "none", 
        axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1, size = 12)) +
  stat_compare_means(aes(group = Treatment), 
                     label = "p.format", 
                     method = "kruskal.test", 
                     hide.ns = TRUE) +
  stat_compare_means(comparisons = list(c("Mock", "Pectobacterium"), c("Mock", "Verticillium")),
                     method = "wilcox.test", 
                     label = "p.format", 
                     hide.ns = TRUE)


